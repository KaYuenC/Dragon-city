def moveenemy():
    global enemyloca, playerloca,occupiedpos,moveE, trap, attackplayer
    attackplayer = 0
    for i in range(len(enemyloca)):
        valid = False
        trap = 0
        while valid == False:
            moveE = random.randint(0, 4)
            trap += 1
            # process input
            if moveE == 0:
                if playerloca == enemyloca[i]-5 and attackplayer == 0:
                    attackplayer = 1
                    valid = True
                    occupiedpos.remove(enemyloca[i])
                    enemyloca[i] -= 5
                    occupiedpos.append(enemyloca[i])

                elif enemyloca[i] > 4 and enemyloca[i]-5 not in occupiedpos:
                    valid = True
                    occupiedpos.remove(enemyloca[i])
                    enemyloca[i] -= 5
                    occupiedpos.append(enemyloca[i])

            if moveE == 1:
                if playerloca == enemyloca[i]+5 and attackplayer == 0:
                    attackplayer = 1
                    valid = True
                    occupiedpos.remove(enemyloca[i])
                    enemyloca[i] += 5
                    occupiedpos.append(enemyloca[i])

                elif enemyloca[i] <= 19 and enemyloca[i]+5 not in occupiedpos:
                    valid = True
                    occupiedpos.remove(enemyloca[i])
                    enemyloca[i] += 5
                    occupiedpos.append(enemyloca[i])

            if moveE == 2:
                if playerloca == enemyloca[i]-1 and attackplayer == 0:
                    attackplayer = 1
                    valid = True
                    occupiedpos.remove(enemyloca[i])
                    enemyloca[i] -= 1
                    occupiedpos.append(enemyloca[i])

                elif enemyloca[i] not in [0, 5, 10, 15, 20] and enemyloca[i]-1 not in occupiedpos:
                    valid = True
                    occupiedpos.remove(enemyloca[i])
                    enemyloca[i] -= 1
                    occupiedpos.append(enemyloca[i])

            if moveE == 3:
                if playerloca == enemyloca[i]+1 and attackplayer == 0:
                    attackplayer = 1
                    valid = True
                    occupiedpos.remove(enemyloca[i])
                    enemyloca[i] += 1
                    occupiedpos.append(enemyloca[i])

                elif enemyloca[i] not in [4, 9, 14, 19, 24] and enemyloca[i]+1 not in occupiedpos:
                    valid = True
                    occupiedpos.remove(enemyloca[i])
                    enemyloca[i] += 1
                    occupiedpos.append(enemyloca[i])

            if moveE == 4:
                valid = True

            if trap > 16:
                valid = True
                break

def openshop():
    global money,items,buyable, itemwant
    itemwant = 0
    while True:
        print("\n\n\n\n ITEM SHOP")
        print("you have", money, "coins remaining")
        print(" ")
        for i in range(len(buyable)):
            for a in range(3):
                if a == 2:
                    print(buyable[i][a], "Coins")
                else:
                    print(buyable[i][a])
            print(" ")

        print("If none, write 'no'")
        itemwant = str(input("What would you like to get? : "))

        if itemwant.upper() == "NO":
            break

        for i in range(len(buyable)):
            if str(buyable[i][0]).upper() == itemwant.upper() and int(buyable[i][2]) <= money:
                items.append(buyable[i][0])
                money -= buyable[i][2]
                print("item bought successfully!")
                time.sleep(1)
                return

        print("Not valid input")
        time.sleep(1)

